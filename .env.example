# 이 파일을 .env 로 복사해서 값을 채웁니다. .env 는 GitHub에 올리지 않습니다.

# SQLite DB 파일 위치 (저장소 루트 기준 상대 경로 또는 절대 경로)
# 비워 두면 기본값 data/processed/ieum.db
DB_PATH=

# API 서버에 접속을 허용할 화면 주소 (쉼표로 여러 개, 예: http://localhost:3000,http://127.0.0.1:3000)
# 비워 두면 기본값 http://localhost:3000
CORS_ORIGINS=

# 시연용 기준일 (YYYY-MM-DD, 예: 2026-07-09). 비우면 실제 오늘 (Asia/Seoul)
# 날짜만 바뀌고 시·분·초는 실제 현재 시각. /health 의 today·demo 로 확인
DEMO_TODAY=

# OpenAI API 키 (LLM 분류·문장 생성용, 없으면 LLM 없이 실행). 실제 값은 .env에만 적고 커밋하지 않음
OPENAI_API_KEY=
# 사용할 모델 (비워 두면 gpt-4.1-mini)
OPENAI_MODEL=
